{
  "name": "@ryu/sites-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Ryu Sites companion, built to one self-contained HTML document.",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "bun test --isolate --max-concurrency=1 src",
    "test:e2e": "playwright test --config playwright.config.mts",
    "test:e2e:sharing": "playwright test --config e2e/sites-sharing.playwright.config.mts",
    "test:e2e:sql": "playwright test --config e2e/sites-sql-recovery.playwright.config.ts"
  },
  "dependencies": {
    "@ryu/app-host": "workspace:*",
    "@ryu/i18n": "workspace:*",
    "@ryu/blocks": "workspace:*",
    "@ryu/ui": "workspace:*",
    "@toolwind/corner-shape": "0.0.8-3",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13",
    "@ryu/browser-local-ai": "workspace:*"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@ryu/config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vite-plugin-singlefile": "^2.3.0",
    "@playwright/test": "^1.58.2"
  }
}
